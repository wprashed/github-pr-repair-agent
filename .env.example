# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USERNAME=your-github-username
GITHUB_API_URL=https://api.github.com

# Service & Scheduler
SCHEDULER_INTERVAL_HOURS=3
AUTOMATION_MODE=auto  # options: 'auto' or 'approval'
MAX_CONCURRENT_REPAIRS=2

# AI Agent Configuration
AGENT_PROVIDER=antigravity  # options: 'antigravity', 'mock', 'claude_code', 'codex'
ANTIGRAVITY_BIN_PATH=/Users/rashed/.gemini/antigravity/bin/agentapi
ANTIGRAVITY_MODEL=flash  # options: 'flash_lite', 'flash', 'pro'
AGENT_TIMEOUT_SECONDS=900

# Safety Controls
SAFETY_MAX_FILES_CHANGED=20
SAFETY_MAX_LINES_ADDED=1000
SAFETY_MAX_LINES_DELETED=1000
SAFETY_ALLOW_NEW_FILES=true
SAFETY_ALLOW_DELETED_FILES=false
SAFETY_SECRET_SCANNING=true

# Repair Limits
REPAIR_MAX_ATTEMPTS=3
REPAIR_RETRY_FAILED=true

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/pr_agent.db
SQLITE_SYNC_URL=sqlite:///./data/pr_agent.db
WORKSPACE_DIR=./workspaces
WORKSPACE_RETENTION_HOURS=24
LOG_LEVEL=INFO

# Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CONSOLE=true
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TO=

# Server & Dashboard
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DASHBOARD_AUTH_TOKEN=
